# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# .env.local is gitignored. Never commit real values.

# Safe to expose to the browser -- but ONLY because RLS is enabled and the
# derived view uses security_invoker (see supabase/migrations/001_schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS completely.
# Used exclusively by the one-off script that creates the evaluation user.
# Must never be prefixed NEXT_PUBLIC_, never added to Vercel's client env,
# and never committed.
SUPABASE_SERVICE_ROLE_KEY=
